    if x % 73 == 0:
        m = min(x, m)
    if x % 100 == 16:
        n = max(x, n)

for i in range(2, len(f)):
    a, b, c = int(f[i-2]), int(f[i-1]), int(f[i])
    if int(a%m == 0) + int(b%m == 0) + int(c%m == 0) == 1:
        if a + b + c >= n:
            k += 1
            s = max(a+b+c, s)

print(k, s)
